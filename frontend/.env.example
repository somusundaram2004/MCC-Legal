# API Base URL (Leave empty for relative URLs in production; Vite dev proxy handles local dev)
VITE_API_BASE_URL=

# Google OAuth Client ID
VITE_GOOGLE_LOGIN_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
