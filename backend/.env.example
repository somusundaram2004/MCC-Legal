# Django Core Settings
SECRET_KEY=YOUR_PRODUCTION_DJANGO_SECRET_KEY
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Database Configuration (PostgreSQL)
DB_NAME=mou_dashboard
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Google Drive OAuth 2.0 & Cloud Storage Integration
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/settings
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID

# Google Service Account (Optional for Server-to-Server operations)
GOOGLE_DRIVE_TYPE=service_account
GOOGLE_DRIVE_PROJECT_ID=YOUR_GOOGLE_PROJECT_ID
GOOGLE_DRIVE_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# File Management Limits
MAX_UPLOAD_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-organization-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
DEFAULT_FROM_EMAIL=Organization Repository <no-reply@example.com>
FRONTEND_URL=https://yourdomain.com
